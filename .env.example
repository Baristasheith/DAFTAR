# انسخ هذا الملف باسم .env.local ثم املأ القيم (لا ترفع .env.local إلى GitHub أبداً)
# يُستخدم في المرحلة الثانية عند ربط Supabase

# رابط مشروع Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# المفتاح العام (anon/publishable) - آمن للاستخدام في الواجهة
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح الخدمة السري - للخادم فقط، لا تضع قبله NEXT_PUBLIC أبداً
SUPABASE_SERVICE_ROLE_KEY=

# سر توقيع جلسة الفرد (PIN). نصّ عشوائي طويل 32 حرفاً فأكثر. ولّده على Windows بالأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
MEMBER_SESSION_SECRET=
# عنوان الموقع (اختياري محلياً). عند النشر ضع رابط Vercel، مثال: https://daftar.vercel.app
NEXT_PUBLIC_SITE_URL=